@@ -0,0 +1,78 @@
+package com.horsecoder.common.whuTalent.core.integration.skill;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+
+public class SkillRegistryClient {
+  private final String baseUrl;
+
+  public SkillRegistryClient(String baseUrl) {
+    if (baseUrl == null || !baseUrl.matches("https?://[^/]+.*")) {
+      throw new IllegalArgumentException("skill.registry.url must be an HTTP(S) URL");
+    }
+    this.baseUrl = baseUrl.replaceAll("/+$", "");
+  }
+
+  public RegistryResponse searchSkills(String query) throws IOException {
+    return request("POST", "/search_skills?query=" + encode(query == null ? "" : query));
+  }
+
+  public RegistryResponse loadSkill(String skillName) throws IOException {
+    if (skillName == null || skillName.trim().isEmpty()) {
+      throw new IllegalArgumentException("skillName must not be empty");
+    }
+    return request("GET", "/load_skill?skill_name=" + encode(skillName));
+  }
+
+  private RegistryResponse request(String method, String path) throws IOException {
+    HttpURLConnection connection = (HttpURLConnection) new URL(baseUrl + path).openConnection();
+    connection.setRequestMethod(method);
+    connection.setConnectTimeout(5000);
+    connection.setReadTimeout(10000);
+    connection.setRequestProperty("Accept", "application/json");
+    try {
+      int status = connection.getResponseCode();
+      InputStream body = status >= 400 ? connection.getErrorStream() : connection.getInputStream();
+      if (body == null) {
+        throw new IOException("Skill registry returned no response body");
+      }
+      try (InputStream stream = body; ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+        byte[] buffer = new byte[8192];
+        int length;
+        while ((length = stream.read(buffer)) != -1) {
+          output.write(buffer, 0, length);
+        }
+        return new RegistryResponse(status, new String(output.toByteArray(), StandardCharsets.UTF_8));
+      }
+    } finally {
+      connection.disconnect();
+    }
+  }
+
+  private static String encode(String value) throws IOException {
+    return URLEncoder.encode(value, "UTF-8");
+  }
+
+  public static class RegistryResponse {
+    private final int status;
+    private final String body;
+
+    public RegistryResponse(int status, String body) {
+      this.status = status;
+      this.body = body;
+    }
+
+    public int getStatus() {
+      return status;
+    }
+
+    public String getBody() {
+      return body;
+    }
+  }
+}
